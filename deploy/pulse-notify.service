[Unit]
Description=PULSE release notification check
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=www-data
Group=www-data
Environment=PULSE_STORAGE=/var/lib/pulse
ExecStart=/usr/bin/php /opt/pulse/current/bin/console.php check-updates --automatic
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pulse
