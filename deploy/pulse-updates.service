[Unit]
Description=PULSE signed release check and night deployment
After=network-online.target pulse-update-recover.service
Wants=network-online.target
Requires=pulse-update-recover.service
[Service]
Type=oneshot
User=root
Group=www-data
ExecStart=/usr/bin/python3 /usr/local/lib/pulse/updater.py tick
TimeoutStartSec=25min
UMask=0027
PrivateTmp=true
ProtectHome=true
# Needs systemd/FPM control; downloaded code runs only as www-data.
