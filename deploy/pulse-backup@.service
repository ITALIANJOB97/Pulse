[Unit]
Description=PULSE %i backup
After=local-fs.target

[Service]
Type=oneshot
User=www-data
Group=www-data
Environment=PULSE_STORAGE=/var/lib/pulse
ExecStart=/usr/bin/php /opt/pulse/current/bin/console.php backup %i
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pulse

